# Prompt Circle Skills - Environment Variables

# Notion API
NOTION_ACCESS_TOKEN=your_notion_integration_token
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id

# Netlify API
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token
NETLIFY_SITE_ID=your_netlify_site_id  # Optional for existing sites

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenClaw
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token

# Fly.io
FLY_API_TOKEN=your_fly_api_token

# Render
RENDER_API_KEY=your_render_api_key

# Railway
RAILWAY_TOKEN=your_railway_token

# Hetzner Cloud
HCLOUD_TOKEN=your_hetzner_cloud_token

# Google Cloud
GCP_SERVICE_ACCOUNT_KEY=your_gcp_service_account_key_json
